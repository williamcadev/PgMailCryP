# Local environment for the Node bridge; copy outside Git and load with --env-file.
# Defaults bind only to loopback. No service or DNS is installed automatically.
STALWART_INGRESS_URL=https://mail-in.example.test/ingress/stalwart
STALWART_INGRESS_TOKEN=
BRIDGE_SMTP_HOST=127.0.0.1
BRIDGE_SMTP_PORT=2525
BRIDGE_SMTP_USER=stalwart
BRIDGE_SMTP_PASSWORD=
BRIDGE_RECIPIENT_DOMAINS=example.net
BRIDGE_ALLOWED_FROM_DOMAINS=example.net
# Optional for production; the bundled test install limits outbound delivery locally.
BRIDGE_ALLOWED_TO_DOMAINS=example.net
BRIDGE_HTTP_HOST=127.0.0.1
BRIDGE_HTTP_PORT=8788
PGP_SMTP_RELAY_TOKEN=
BRIDGE_STATE_DIR=/var/lib/pgmailcryp-bridge
BRIDGE_TLS_CERT=
BRIDGE_TLS_KEY=
# Enable only for isolated tests using loopback, never an Internet listener.
BRIDGE_ALLOW_INSECURE_LOOPBACK=0
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_SECURE=0
SMTP_RELAY_USER=
SMTP_RELAY_PASSWORD=
